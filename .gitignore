.ruff_cache/

# -----------------------------------------------------------------------------
# SQLite Database & Local State (Authoritative DB stays local)
# -----------------------------------------------------------------------------
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# Local Uploads (Preserve directory structure via .gitkeep)
backend/data/uploads/*
!backend/data/uploads/.gitkeep
!backend/data/uploads/products/.gitkeep

